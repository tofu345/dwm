#!/bin/bash
exec >&/dev/null

# emulate pause butten presses on earphones
# 1 = pause, 2 = next, 3 = previous

# timeout at start and after each button press
timeout=0.5

# send USR1 to an older process if any
pid=$(pgrep -ox dwm-audio-play)
if [[ -n "$pid" && "$pid" != $$ ]]; then
    /bin/kill -SIGUSR1 "$pid"
    exit
fi

presses=0

run() {
    case $presses in
        1) playerctl play-pause;;
        2) playerctl next;;
        *) playerctl previous;;
    esac
    exit
}

# increase "presses" on SIGUSR1
handler() {
    trap handler USR1
    presses=$((presses + 1))
    [[ $presses == 3 ]] && run

    sleep $timeout &
    wait # wait for timouts
    run
}

# run in sub process
handler &
