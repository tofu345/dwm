#!/bin/sh

# NOTE: doas must not require a password for `tlp`

opts="Performance
Balanced
Power Saver"
current=$(tlp-stat -m)
selected=$(echo "$opts" | rofi -dmenu -i -select "$(echo $current | sed 's/[\/-].*//')" -p "$current")

exec >&/dev/null
case $selected in
    Performance)    doas tlp performance;;
    Balanced)       doas tlp balanced;;
    "Power Saver")  doas tlp power-saver;;
esac
